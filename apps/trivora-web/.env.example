# ─── Trivora — Web ────────────────────────────────────────────────────────────
TRIVORA_DATABASE_URL="postgresql://user:password@localhost:5432/trivora"

NEXTAUTH_URL="http://localhost:3100"
NEXTAUTH_SECRET=""

# HMAC secret shared with apps/trivora-realtime — must match TRIVORA_REALTIME_SECRET there
TRIVORA_REALTIME_SECRET=""

# Public URL of apps/trivora-realtime, reachable from the browser
NEXT_PUBLIC_TRIVORA_REALTIME_URL="http://localhost:4001"

# Network-reachable URL of this app, used to build the QR-code join link on the
# host lobby. Set this to your machine's LAN address (not "localhost") so
# players' phones can actually reach it — e.g. "http://192.168.1.42:3100".
NEXT_PUBLIC_APP_URL="http://localhost:3100"
